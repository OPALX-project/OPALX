OPTION, ECHO = FALSE, PSDUMPFREQ = 0, STATDUMPFREQ = 0, VERSION = 10900, ASCIIDUMP = FALSE;

OPTION, ENABLELINEARTRANSFERMAPS = TRUE;

TITLE, STRING = "map-2 symmetric hard-edge double-bend achromat";

REAL P0 = 0.2505104781131461;
REAL RHO = 2.0;
REAL THETA = PI / 6;
REAL LB = RHO * THETA;
REAL LD = 1.0;
REAL LQ = 0.2;
// Exact thick-lens solution of R16=R26=0 for B-D-Q-D-B with these dimensions.
REAL KACH = -6.371966681365967;

B1: SBEND, L = LB, ANGLE = THETA, HGAP = 0.0, FINT = 0.0, ELEMEDGE = 0.0;
D1: DRIFT, L = LD, ELEMEDGE = LB;
QACH: QUADRUPOLE, L = LQ, K1 = KACH, ELEMEDGE = LB + LD;
D2: DRIFT, L = LD, ELEMEDGE = LB + LD + LQ;
B2: SBEND, L = LB, ANGLE = THETA, HGAP = 0.0, FINT = 0.0,
    ELEMEDGE = LB + 2 * LD + LQ;
LATTICE: LINE = (B1, D1, QACH, D2, B2);

DIST: DISTRIBUTION, TYPE = FROMFILE, FNAME = "../reference-particle.txt", NPARTDIST = 1;
SOURCE: EMISSIONSOURCE, DISTRIBUTION = DIST;
SOURCES: EMISSIONSOURCELIST = (SOURCE);
FS: FIELDSOLVER, TYPE = NONE, NX = 16, NY = 16, NZ = 16,
    PARFFTX = TRUE, PARFFTY = TRUE, PARFFTZ = TRUE,
    BCFFTX = OPEN, BCFFTY = OPEN, BCFFTZ = OPEN,
    BBOXINCR = 1, GREENSF = INTEGRATED;
BEAM1: BEAM, PARTICLE = ELECTRON, NALLOC = 1,
       BCHARGE = 1.6021766339999998e-19, SOURCES = SOURCES, CHARGE = -1;

OPTION, ENABLELINEARTRANSFERMAPS=TRUE, LINEARTRANSFERMAPRICHARDSON=0, LINEARTRANSFERMAPSTEPS={9.9999999999999995e-07,9.9999999999999995e-07,9.9999999999999995e-07,9.9999999999999995e-07,9.9999999999999995e-07,9.9999999999999995e-07}, LINEARTRANSFERMAPINTEGRATOR="BORIS";

TRACK, LINE = LATTICE, BEAM = BEAM1, MAXSTEPS = 1, DT = 3.0e-11,
      ZSTOP = 2 * LB + 2 * LD + LQ;
RUN, METHOD = "PARALLEL", FIELDSOLVER = FS;
ENDTRACK;
QUIT;
