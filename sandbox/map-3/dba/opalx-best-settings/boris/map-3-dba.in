OPTION, ECHO = FALSE, PSDUMPFREQ = 0, STATDUMPFREQ = 0, VERSION = 10900, ASCIIDUMP = FALSE;
OPTION, ENABLELINEARTRANSFERMAPS = TRUE;

TITLE, STRING = "map-3 finite-fringe DBA geometry; unmatched quadrupole seed";

REAL P0 = 0.2505104781131461;
REAL RHO = 2.0;
REAL THETA = PI / 6;
REAL LB = RHO * THETA;
REAL LD = 1.0;
REAL LQ = 0.2;
REAL HALF_GAP = 0.1;
REAL FRINGE_INTEGRAL = 0.1;
REAL W = 5 * (2 * HALF_GAP);
// Retained map-2 K1 is a seed only: not matched for this field profile/spacing.
REAL KACH = -6.371966681365967;

// ELEMEDGE is the BODY entrance. Each bend support extends W outside each face.
// D1 and D2 are explicitly field-free; no dipole field-integral renormalization.
B1: SBEND, L = LB, ANGLE = THETA, HGAP = HALF_GAP, FINT = FRINGE_INTEGRAL,
    ELEMEDGE = W;
D1: DRIFT, L = LD, ELEMEDGE = LB + 2 * W;
QACH: QUADRUPOLE, L = LQ, K1 = KACH, ELEMEDGE = LB + 2 * W + LD;
D2: DRIFT, L = LD, ELEMEDGE = LB + 2 * W + LD + LQ;
B2: SBEND, L = LB, ANGLE = THETA, HGAP = HALF_GAP, FINT = FRINGE_INTEGRAL,
    ELEMEDGE = LB + 3 * W + 2 * LD + LQ;
LATTICE: LINE = (B1, D1, QACH, D2, B2);

DIST: DISTRIBUTION, TYPE = FROMFILE, FNAME = "../reference-particle.txt", NPARTDIST = 1;
SOURCE: EMISSIONSOURCE, DISTRIBUTION = DIST;
SOURCES: EMISSIONSOURCELIST = (SOURCE);
FS: FIELDSOLVER, TYPE = NONE, NX = 16, NY = 16, NZ = 16,
    PARFFTX = TRUE, PARFFTY = TRUE, PARFFTZ = TRUE,
    BCFFTX = OPEN, BCFFTY = OPEN, BCFFTZ = OPEN,
    BBOXINCR = 1, GREENSF = INTEGRATED;
BEAM1: BEAM, PARTICLE = ELECTRON, NALLOC = 1,
       BCHARGE = 1.6021766339999998e-19, SOURCES = SOURCES, CHARGE = -1;

// The runner adds each integrator's archived best map options and replaces DT.
// OrbitThreader builds the full requested map even with one production step.
OPTION, ENABLELINEARTRANSFERMAPS=TRUE, LINEARTRANSFERMAPRICHARDSON=1, LINEARTRANSFERMAPSTEPS={1.0000000000000001e-05,1.0000000000000001e-05,1.0000000000000001e-05,1.0000000000000001e-05,1.0000000000000001e-05,1.0000000000000001e-05}, LINEARTRANSFERMAPINTEGRATOR="BORIS";

TRACK, LINE = LATTICE, BEAM = BEAM1, MAXSTEPS = 1, DT=1.0000000000000000e-13,
      ZSTOP = 2 * LB + 4 * W + 2 * LD + LQ;
RUN, METHOD = "PARALLEL", FIELDSOLVER = FS;
ENDTRACK;
QUIT;
