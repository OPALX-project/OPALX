OPTION, PSDUMPFREQ = 1;
OPTION, STATDUMPFREQ = 1;
OPTION, C0PSDUMPFREQ = 1;
OPTION, BOUNDPDESTROY = 1.0e9;
OPTION, VERSION = 10900;
OPTION, ASCIIDUMP = FALSE;
OPTION, EBDUMP = TRUE;
OPTION, IDEALIZED = TRUE;
OPTION, SEED = 20260629;

TITLE, STRING = "OPALX/MSOL matched-charge 10-step C0 field dump";

// Initial-condition diagnostic for comparison with the manufactured solution:
//
//   sandbox/analytic-model/note/manufactured_initial_e_field.tex
//
// The electron/positron witnesses are injected from the CAIN/TestParticleOrbit
// first rows and are active for the first BeamBeam space-charge field gather.
// The run uses one near-zero time step only; this is intended to inspect the
// gathered initial fields, not to track the e-/e+ trajectories.
//
// The manufactured model evaluates each pair at its own CAIN ct value.  This
// OPALX deck instead uses one global clock and encodes those timings as the
// witness longitudinal offsets, matching the historic OPALX FROMFILE
// convention used by the archived reference deck.

REAL primary_kinetic_energy = 0.245;
REAL primary_gamma = (primary_kinetic_energy + EMASS) / EMASS;
REAL primary_beta = sqrt(1.0 - 1.0 / (primary_gamma^2));
REAL primary_p0 = primary_gamma * primary_beta * EMASS;
REAL primary_beta_gamma = primary_p0 / EMASS;

REAL primary_sigma_xy = 1.944325075701e-6;
REAL primary_sigma_z = 0.274e-3;
REAL primary_sigma_xyp = 1.0e-12;
REAL primary_sigma_pxy = primary_beta_gamma * primary_sigma_xyp;

// OPALX/MSOL matched-charge comparison.  MSOL uses the same signed source
// charge, Q = -1.552147229500376e-09 C, via msol_matched_charge.json.
REAL primary_charge_scale = 0.7750192814260582;
REAL primary_electrons_per_bunch = 1.25e10 * primary_charge_scale;
REAL primary_macroparticles = 400000;
REAL elementary_charge = 1.602176634e-19;
REAL primary_bunch_charge = primary_electrons_per_bunch * elementary_charge;

REAL n_witness_per_species = 6;
REAL witness_bunch_charge = n_witness_per_species * elementary_charge;
REAL witness_p0 = sqrt(3.0) * EMASS;

REAL bb_length = 0.006;
REAL bb_ip_s = 0.5 * bb_length;

// Manufactured-model finite-source centroid offset for the copropagating source
// with seed 20260629 and 400k macro-particles.  The CAIN/MSOL initial row is
// at t = -3.0020768567833684 ps, not at the source-IP crossing.  Shift the
// OPALX primary source upstream by beta*c*t so OPALX Step#0 matches MSOL
// step 0 instead of MSOL step 500.
REAL manufactured_source_centroid_z = 2.933656e-7;
REAL msol_initial_time = -3.0020768567833684e-12;
REAL primary_source_r0z = bb_ip_s + manufactured_source_centroid_z
                         + primary_beta * CLIGHT * msol_initial_time;

// Short run for OPALX C0 particle-sampled field contour diagnostics.
REAL dt_track = 5.0e-15;
REAL track_steps = 10;

REAL NXY = 16;
REAL NZ = 32;

IP1: BEAMBEAM,
    L = bb_length,
    ELEMEDGE = 0.0,
    VISUALIZE = FALSE,
    COPY_TIME = 0.0,
    WITNESS_CONTAINERS = "1,2",
    RETIRE_TIME = 10.0e-12,
    IP_S = bb_ip_s,
    APERTURE = "CIRCLE(0.0010)";

LINE1: LINE = (IP1);

SOURCEBINNING: BINNING,
    MAXBINS = 1,
    DESIREDWIDTH = 0.1,
    BINNINGALPHA = 1.0,
    BINNINGBETA = 1.0,
    PARAMETER = "VELOCITYZ",
    ADAPTIVEBINNING = FALSE,
    DUMPBINSFILE = "NONE",
    TABLEPRINTFREQ = 0;

FS0: FIELDSOLVER,
    TYPE = OPEN,
    BINS = "SOURCEBINNING",
    NX = NXY,
    NY = NXY,
    NZ = NZ,
    PARFFTX = FALSE,
    PARFFTY = FALSE,
    PARFFTZ = TRUE,
    BCFFTX = OPEN,
    BCFFTY = OPEN,
    BCFFTZ = OPEN,
    BBOXINCR = 1,
    GREENSF = STANDARD;

DIST_PRIMARY_ELECTRONS: DISTRIBUTION,
    TYPE = GAUSS,
    SIGMAX = primary_sigma_xy,
    SIGMAY = primary_sigma_xy,
    SIGMAZ = primary_sigma_z,
    SIGMAPX = primary_sigma_pxy,
    SIGMAPY = primary_sigma_pxy,
    SIGMAPZ = 1.0e-12,
    NPARTDIST = primary_macroparticles;

DIST_WITNESS_ELECTRONS: DISTRIBUTION,
    TYPE = FROMFILE,
    FNAME = "atic/track12_electrons.fromfile",
    NPARTDIST = n_witness_per_species;

DIST_WITNESS_POSITRONS: DISTRIBUTION,
    TYPE = FROMFILE,
    FNAME = "atic/track12_positrons.fromfile",
    NPARTDIST = n_witness_per_species;

SOURCE_PRIMARY_ELECTRONS: EMISSIONSOURCE,
    DISTRIBUTION = DIST_PRIMARY_ELECTRONS,
    R0Z = primary_source_r0z;

SOURCE_WITNESS_ELECTRONS: EMISSIONSOURCE,
    DISTRIBUTION = DIST_WITNESS_ELECTRONS,
    R0Z = bb_ip_s;

SOURCE_WITNESS_POSITRONS: EMISSIONSOURCE,
    DISTRIBUTION = DIST_WITNESS_POSITRONS,
    R0Z = bb_ip_s;

PRIMARY_ELECTRON_SOURCES: EMISSIONSOURCELIST = (SOURCE_PRIMARY_ELECTRONS);
WITNESS_ELECTRON_SOURCES: EMISSIONSOURCELIST = (SOURCE_WITNESS_ELECTRONS);
WITNESS_POSITRON_SOURCES: EMISSIONSOURCELIST = (SOURCE_WITNESS_POSITRONS);

PRIMARY_ELECTRONS: BEAM,
    PARTICLE = ELECTRON,
    PC = primary_p0,
    NALLOC = primary_macroparticles,
    BCHARGE = primary_bunch_charge,
    SOURCES = PRIMARY_ELECTRON_SOURCES;

WITNESS_ELECTRONS: BEAM,
    PARTICLE = ELECTRON,
    NALLOC = n_witness_per_species,
    BCHARGE = witness_bunch_charge,
    SOURCES = WITNESS_ELECTRON_SOURCES;

WITNESS_POSITRONS: BEAM,
    PARTICLE = POSITRON,
    NALLOC = n_witness_per_species,
    BCHARGE = witness_bunch_charge,
    SOURCES = WITNESS_POSITRON_SOURCES;

TRACK,
    LINE = LINE1,
    BEAMS = {PRIMARY_ELECTRONS, WITNESS_ELECTRONS, WITNESS_POSITRONS},
    MAXSTEPS = track_steps,
    DT = dt_track,
    ZSTART = 0.0,
    ZSTOP = 0.05;

RUN,
    METHOD = "PARALLEL",
    FIELDSOLVER = FS0;

ENDTRACK;

QUIT;
