OPTION, PSDUMPFREQ = 50000;
OPTION, STATDUMPFREQ = 100;
OPTION, BOUNDPDESTROY = 10;
OPTION, VERSION = 10900;
OPTION, ASCIIDUMP = FALSE;

OPTION, ENABLELINEARTRANSFERMAPS=FALSE;

Title, string = "test-sbend-ring-1 ten analytic SBEND one-turn ring seed";

// One-turn ten-SBEND ring placement seed.
//
// This input is based on sandbox/test-sbend-ring-1:
//   - one vertically offset electron,
//   - sequential ELEMEDGE placement,
//   - no space charge,
//   - OPAL FM1DProfile1-style fringe parameters.
//
// Ring geometry:
//   N bends                 = 10
//   arc length per bend     = 1.0 m
//   drift between bends     = 0.25 m
//   bend angle per cell     = 2*pi/N = 36 deg
//
// OPALX positive SBEND ANGLE bends toward negative global X for an initial
// tangent along +Z. PlacementResolver advances the entrance frame through
// each bend and the following 25 cm drift.
//
// Beam:
//   electron kinetic energy = 250 MeV
//   beta*gamma              = 490.23677597553325
// The beta*gamma value is supplied by the FROMFILE distribution. P0 is the
// corresponding reference momentum in GeV/c and sets the SBEND rigidity.

REAL P0 = 0.2505104781131461;

REAL N_BENDS      = 10.0;
REAL DRIFT_LENGTH = 0.25;
REAL BEND_LENGTH  = 1.0;
REAL BEND_ANGLE   = 2 * PI / N_BENDS;
REAL BEND_HGAP    = 0.02;
REAL BEND_HAPERT  = 0.10;
REAL BEND_FINT    = 0.5;

// OPALX SBEND::L is the reference-arc length. Elements use ELEMEDGE so the
// PlacementResolver constructs every entrance frame along the reference path.
REAL TURN_LENGTH  = N_BENDS * (BEND_LENGTH + DRIFT_LENGTH);

MSTART: MONITOR,
    L = 0.0,
    ELEMEDGE = 0.0,
    APERTURE = "rectangle(0.20, 0.04)",
    TYPE = TEMPORAL,
    OUTFN = "test-sbend-ring-1_start";

B1: SBEND, L = BEND_LENGTH, ANGLE = BEND_ANGLE,
    HGAP = BEND_HGAP, HAPERT = BEND_HAPERT, FINT = BEND_FINT, ELEMEDGE = 0.0;
D1: DRIFT, L = DRIFT_LENGTH, APERTURE = "rectangle(0.20, 0.04)", ELEMEDGE = 1.0;

B2: SBEND, L = BEND_LENGTH, ANGLE = BEND_ANGLE,
    HGAP = BEND_HGAP, HAPERT = BEND_HAPERT, FINT = BEND_FINT, ELEMEDGE = 1.25;
D2: DRIFT, L = DRIFT_LENGTH, APERTURE = "rectangle(0.20, 0.04)", ELEMEDGE = 2.25;

B3: SBEND, L = BEND_LENGTH, ANGLE = BEND_ANGLE,
    HGAP = BEND_HGAP, HAPERT = BEND_HAPERT, FINT = BEND_FINT, ELEMEDGE = 2.50;
D3: DRIFT, L = DRIFT_LENGTH, APERTURE = "rectangle(0.20, 0.04)", ELEMEDGE = 3.50;

B4: SBEND, L = BEND_LENGTH, ANGLE = BEND_ANGLE,
    HGAP = BEND_HGAP, HAPERT = BEND_HAPERT, FINT = BEND_FINT, ELEMEDGE = 3.75;
D4: DRIFT, L = DRIFT_LENGTH, APERTURE = "rectangle(0.20, 0.04)", ELEMEDGE = 4.75;

B5: SBEND, L = BEND_LENGTH, ANGLE = BEND_ANGLE,
    HGAP = BEND_HGAP, HAPERT = BEND_HAPERT, FINT = BEND_FINT, ELEMEDGE = 5.00;
D5: DRIFT, L = DRIFT_LENGTH, APERTURE = "rectangle(0.20, 0.04)", ELEMEDGE = 6.00;

B6: SBEND, L = BEND_LENGTH, ANGLE = BEND_ANGLE,
    HGAP = BEND_HGAP, HAPERT = BEND_HAPERT, FINT = BEND_FINT, ELEMEDGE = 6.25;
D6: DRIFT, L = DRIFT_LENGTH, APERTURE = "rectangle(0.20, 0.04)", ELEMEDGE = 7.25;

B7: SBEND, L = BEND_LENGTH, ANGLE = BEND_ANGLE,
    HGAP = BEND_HGAP, HAPERT = BEND_HAPERT, FINT = BEND_FINT, ELEMEDGE = 7.50;
D7: DRIFT, L = DRIFT_LENGTH, APERTURE = "rectangle(0.20, 0.04)", ELEMEDGE = 8.50;

B8: SBEND, L = BEND_LENGTH, ANGLE = BEND_ANGLE,
    HGAP = BEND_HGAP, HAPERT = BEND_HAPERT, FINT = BEND_FINT, ELEMEDGE = 8.75;
D8: DRIFT, L = DRIFT_LENGTH, APERTURE = "rectangle(0.20, 0.04)", ELEMEDGE = 9.75;

B9: SBEND, L = BEND_LENGTH, ANGLE = BEND_ANGLE,
    HGAP = BEND_HGAP, HAPERT = BEND_HAPERT, FINT = BEND_FINT, ELEMEDGE = 10.00;
D9: DRIFT, L = DRIFT_LENGTH, APERTURE = "rectangle(0.20, 0.04)", ELEMEDGE = 11.00;

B10: SBEND, L = BEND_LENGTH, ANGLE = BEND_ANGLE,
    HGAP = BEND_HGAP, HAPERT = BEND_HAPERT, FINT = BEND_FINT, ELEMEDGE = 11.25;
D10: DRIFT, L = DRIFT_LENGTH, APERTURE = "rectangle(0.20, 0.04)", ELEMEDGE = 12.25;

MCLOSE: MONITOR,
    L = 0.0,
    ELEMEDGE = TURN_LENGTH,
    APERTURE = "rectangle(0.20, 0.04)",
    TYPE = TEMPORAL,
    OUTFN = "test-sbend-ring-1_close";

Line1: RING = (
MSTART,
B1, D1,
B2, D2,
B3, D3,
B4, D4,
B5, D5,
B6, D6,
B7, D7,
B8, D8,
B9, D9,
B10, D10,
MCLOSE
);


LineOLD: LINE = (
MSTART,
B1, D1,
B2, D2,
B3, D3,
B4, D4,
B5, D5,
B6, D6,
B7, D7,
B8, D8,
B9, D9,
B10, D10,
MCLOSE
);


Dist0: DISTRIBUTION,
    TYPE = FROMFILE,
    FNAME = "test-sbend-ring-1_distribution.txt",
    NPARTDIST = 1;

ES0: EMISSIONSOURCE, DISTRIBUTION = Dist0;
Sources0: EMISSIONSOURCELIST = (ES0);

FS0: FIELDSOLVER,
    TYPE = NONE,
    NX = 16,
    NY = 16,
    NZ = 16,
    PARFFTX = true,
    PARFFTY = true,
    PARFFTZ = true,
    BCFFTX = open,
    BCFFTY = open,
    BCFFTZ = open,
    BBOXINCR = 1,
    GREENSF = INTEGRATED;

BEAM0: BEAM,
    PARTICLE = ELECTRON,
    NALLOC = 1,
    BCHARGE = 1.6021766339999998e-19,
    SOURCES = Sources0,
    CHARGE = -1;

TRACK,
    LINE = Line1,
    BEAM = BEAM0,
    MAXSTEPS = 50000,
    DT = 5.0e-12,
    ZSTOP = 1.0e6;

RUN,
    METHOD = "PARALLEL",
    FIELDSOLVER = FS0,
    TURNS=1;

ENDTRACK;

QUIT;
