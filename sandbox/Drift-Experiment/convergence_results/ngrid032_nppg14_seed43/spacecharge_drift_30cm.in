OPTION, PSDUMPFREQ = -1;
OPTION, STATDUMPFREQ = 1;
OPTION, BOUNDPDESTROY = 10;
OPTION, VERSION = 10900;
OPTION, ASCIIDUMP = FALSE;
OPTION, IDEALIZED = TRUE;
OPTION, SEED = 43;

TITLE, STRING = "c0-only 30 cm drift space-charge field validation";

REAL N_GRID = 32;
REAL NPPG = 14;
REAL N_PARTICLES = N_GRID * N_GRID * N_GRID * NPPG;
REAL DRIFT_LENGTH = 0.30;
REAL SIGMA_R = 1.0e-3;
REAL BUNCH_CHARGE = 1.0e-9;

REAL EKIN_GEV = 0.25;
REAL GAMMA0 = (EKIN_GEV + EMASS) / EMASS;
REAL BETA0 = sqrt(1.0 - 1.0 / (GAMMA0 * GAMMA0));
REAL P0 = GAMMA0 * BETA0 * EMASS;
REAL DT_ONE_STEP = DRIFT_LENGTH / (BETA0 * CLIGHT);

D1: DRIFT,
    L = DRIFT_LENGTH,
    ELEMEDGE = 0.0;

LINE1: LINE = (D1);

DIST0: DISTRIBUTION,
    TYPE = GAUSS,
    SIGMAX = SIGMA_R,
    SIGMAY = SIGMA_R,
    SIGMAZ = SIGMA_R,
    SIGMAPX = 1.0e-12,
    SIGMAPY = 1.0e-12,
    SIGMAPZ = 1.0e-12,
    NPARTDIST = N_PARTICLES;

ES0: EMISSIONSOURCE,
    DISTRIBUTION = DIST0;

SOURCES0: EMISSIONSOURCELIST = (ES0);

FS0: FIELDSOLVER,
    TYPE = OPEN,
    NX = N_GRID,
    NY = N_GRID,
    NZ = N_GRID,
    PARFFTX = TRUE,
    PARFFTY = TRUE,
    PARFFTZ = FALSE,
    BCFFTX = OPEN,
    BCFFTY = OPEN,
    BCFFTZ = OPEN,
    BBOXINCR = 4,
    GREENSF = INTEGRATED;

BEAM0: BEAM,
    PARTICLE = ELECTRON,
    PC = P0,
    NALLOC = N_PARTICLES,
    BCHARGE = BUNCH_CHARGE,
    SOURCES = SOURCES0,
    CHARGE = -1;

TRACK,
    LINE = LINE1,
    BEAM = BEAM0,
    MAXSTEPS = 1,
    DT = DT_ONE_STEP,
    ZSTART = 0.0,
    ZSTOP = DRIFT_LENGTH;

RUN,
    METHOD = "PARALLEL",
    FIELDSOLVER = FS0;

ENDTRACK;

QUIT;
