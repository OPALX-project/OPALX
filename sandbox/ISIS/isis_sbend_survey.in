    sp5_qds, sp5_dr13, sp6_dip1, sp5_dr13a, sp6_vbe, sp6_dr2b, sp6_dr3a, sp6_dr3b,
    sp6_qd, sp6_dr4, sp6_qtd, sp6_dr5, sp6_qf, sp6_dr6, sp6_qtf, sp6_dr7,
    sp6_rf2, sp6_dr12, sp6_qds, sp6_dr13, sp7_dip1, sp7_dr1, sp7_dr2a, sp7_dr2b,
    sp7_dr3a, sp7_dr3b, sp7_qd, sp7_dr4, sp7_qtd, sp7_dr5, sp7_qf, sp7_dr6,
    sp7_qtf, sp7_dr7, sp7_rf, sp7_dr12, sp7_qds, sp7_dr13, sp8_dip1, sp8_dr1,
    sp8_rf2, sp8_dr2, sp8_qd, sp8_dr4, sp8_qtd, sp8_dr5, sp8_qf, sp8_dr6,
    sp8_qtf, sp8_dr7, sp8_rf, sp8_dr12, sp8_qds, sp8_dr13, sp9_dip1, sp8_dr13a,
    sp9_dr2a, sp9_dr2b, sp9_dr3a, sp9_dr3b, sp9_qd, sp9_dr4, sp9_qtd, sp9_dr5,
    sp9_qf, sp9_dr6, sp9_qtf, sp9_dr7, sp9_rf, sp9_dr12, sp9_qds, sp9_dr13,
    sp0_dip1, MCLOSE
);

Dist0: DISTRIBUTION, TYPE = FROMFILE,
    FNAME = "isis_sbend_survey_distribution.txt", NPARTDIST = 1;
ES0: EMISSIONSOURCE, DISTRIBUTION = Dist0;
Sources0: EMISSIONSOURCELIST = (ES0);
FS0: FIELDSOLVER, TYPE = NONE, NX = 16, NY = 16, NZ = 16,
    PARFFTX = true, PARFFTY = true, PARFFTZ = true,
    BCFFTX = open, BCFFTY = open, BCFFTZ = open,
    BBOXINCR = 1, GREENSF = INTEGRATED;
BEAM0: BEAM, PARTICLE = PROTON, NALLOC = 1,
    BCHARGE = 1.602176634e-19, SOURCES = Sources0, CHARGE = 1;

// One step is sufficient to construct and export the complete placement survey.
TRACK, LINE = ISIS_SURVEY, BEAM = BEAM0, MAXSTEPS = 1,
    DT = 1.0e-10, ZSTOP = 1.0e6;
RUN, METHOD = "PARALLEL", FIELDSOLVER = FS0;
ENDTRACK;

QUIT;
