// OPAL 2022.1: one proton, magnetic coasting, explicit Boris/leapfrog integrator.
OPTION, VERSION=20200, ECHO=FALSE, SPTDUMPFREQ=1;
OPTION, PSDUMPFREQ=1, PSDUMPEACHTURN=FALSE, PSDUMPFRAME=GLOBAL;
REAL Edes=0.072;
REAL gamma=(Edes+PMASS)/PMASS;
REAL P0=sqrt(gamma^2-1)*PMASS;
TC1: TRIMCOIL, TYPE="PSI-BFIELD-MIRRORED", RMIN=4350, RMAX=4470,
     BMAX=1.4e-3, SLPTC=0.6;
CYC: CYCLOTRON, TYPE=RING, CYHARMON=6, PHIINIT=0, PRINIT=-0.000240,
     RINIT=2131.4, SYMMETRY=8, RFFREQ=50.65, FMAPFN="../bfield.dat", TRIMCOIL=TC1;
L1: LINE=(CYC);
D1: DISTRIBUTION, TYPE=FROMFILE, FNAME="dist2.dat";
FS1: FIELDSOLVER, FSTYPE=NONE, MX=16, MY=16, MT=16,
     PARFFTX=TRUE, PARFFTY=TRUE, PARFFTT=FALSE,
     BCFFTX=OPEN, BCFFTY=OPEN, BCFFTT=OPEN;
B1: BEAM, PARTICLE=PROTON, PC=P0, NPART=1, BCURRENT=1e-6, BFREQ=50.65;
SELECT, LINE=L1;
TRACK, LINE=L1, BEAM=B1, MAXSTEPS=724, STEPSPERTURN=720, TIMEINTEGRATOR="LF2";
RUN, METHOD="CYCLOTRON-T", BEAM=B1, FIELDSOLVER=FS1, DISTRIBUTION=D1;
ENDTRACK;
STOP;
