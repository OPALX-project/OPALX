+                                                                 const NDIndex<Dim>& rhs) const {
+        for (unsigned d = 0; d < Dim; ++d) {
+            if (lhs[d].last() < rhs[d].first() || rhs[d].last() < lhs[d].first()) {
+                return false;
+            }
+        }
+        return true;
+    }
