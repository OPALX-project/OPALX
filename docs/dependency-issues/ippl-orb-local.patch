+        const std::vector<NDIndex<Dim>>& domains, const NDIndex<Dim>& globalDomain,
+        const std::array<bool, Dim>& allowedAxes) const {
+        size_t globalCells = 1;
+        for (unsigned d = 0; d < Dim; ++d) {
