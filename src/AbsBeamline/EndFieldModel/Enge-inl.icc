// #include "Utilities/GSLCompat.h"
namespace endfieldmodel {

    KOKKOS_INLINE_FUNCTION double gsl_sf_fact_kokkos(unsigned int n) {
        double result = 1.0;
        for (unsigned int i = 2; i <= n; ++i) {
            result *= i;
        }
        return result;
    }

    void Enge::setMaximumDerivative(size_t n) { Enge::setEngeDiffIndices(n); }

    EngeDerivativeTable Enge::getQIndex(int n) { return q_m[n]; }

    std::vector<std::vector<int> > Enge::getHIndex(int n) { return h_m[n]; }

    double Enge::getCentreLength() const { return config_m.x0_m * 2.0; }

    double Enge::getEndLength() const { return config_m.lambda_m; }

    void Enge::function(
            const Kokkos::View<double*>& xView, const int n, Kokkos::View<double**>& values) const {
        EngeConfig config = config_m;
        Enge::functionHost(config, xView, n, values);
    }

    void Enge::functionHost(
            const EngeConfig& config, const Kokkos::View<double*>& xView, const int n,
            Kokkos::View<double**>& derivatives) {
        validateDerivativeOrder(n);
        const size_t count = xView.extent(0);
        if (derivatives.extent(0) != xView.extent(0)) {
            throw OpalException("Enge::functionHost", "derivatives extent did not match x extent");
        }
        if (derivatives.extent(1) != size_t(n + 1)) {
            throw OpalException("Enge::functionHost", "derivatives extent should be n + 1");
        }
        Kokkos::parallel_for(
                "Enge::functionHost()", count, KOKKOS_LAMBDA(const size_t i) {
                    auto values = Kokkos::subview(derivatives, i, Kokkos::ALL);
                    double x    = xView(i);
                    Enge::functionDevice(config, x, n, values);
                });
    }

    template <class Config, class C>
    KOKKOS_INLINE_FUNCTION void Enge::functionPoint(
            const Config& config, double x, int n, C values) {
        EngeWorkspace wsLow;
        getEngeImpl(config, x - config.x0_m, n, wsLow);
        EngeWorkspace wsHigh;
        getEngeImpl(config, -x - config.x0_m, n, wsHigh);
        double* engeLow  = wsLow.enge;
        double* engeHigh = wsHigh.enge;
        values(0)        = -1 + (engeLow[0] + engeHigh[0]);
        for (int i = 1; i <= n; ++i) {
            if (i % 2 == 1)
                values(i) = +engeLow[i] - engeHigh[i];
            else
                values(i) = +engeLow[i] + engeHigh[i];
        }
    }

    template <class Config>
    KOKKOS_INLINE_FUNCTION void Enge::setupWorkspaceImpl(
            const Config& config, double x, int n, EngeWorkspace& ws) {
        // Establish the complete prefix before getEnge or functionDevice reads it.
        if (n < 0 || n > EngeWorkspace::max_derivative)
            Kokkos::abort("Enge: derivative order must be between 0 and 12");
        for (int i = 0; i <= n; i++) {
            ws.hNVec[i] = hNImpl(config, x, i);
        }
        ws.exp_h0 = exp(ws.hNVec[0]);
        for (int i = 0; i <= n; ++i) {
            ws.gNVec[i] = gNImpl(config, i, ws);
        }
    }

    // Use
    // d^n E/dx^n = a_n1m1 F(n1) g(m1) + a_n2m1m2 F(n2) g(m1)g(m2)+...
    // where
    template <class Config>
    KOKKOS_INLINE_FUNCTION double Enge::getEngeImpl(
            const Config& config, double x, int n, EngeWorkspace& ws) {
        setupWorkspaceImpl(config, x, n, ws);
        for (int k = 0; k <= n; ++k) {
            const auto& qt = config.gIndices[k];
            double e       = 0;
            for (size_t i = 0; i < qt.extent(0); ++i) {
                double ei(qt(i, 0));
                for (size_t j = 1; j < qt.extent(1); ++j) {
                    double de = Kokkos::pow(ws.gNVec[j - 1], static_cast<int>(qt(i, j)));
                    ei *= de;
                }
                if (ei != ei) ei = 0;  // div 0, usually g == 0 and index < 0
                e += ei;
            }
            ws.enge[k] = e;
        }
        return ws.enge[n];
    }

    // h     = a_0+a_1 (x/w)+a_2 (x/w)^2+a_3 (x/w)^3+...+a_m (x/w)^m
    // h^(n) = d^nh/dx^n = sum^m_{i=n} a_i x^{i-n}/w^i i!/n!
    template <class Config>
    KOKKOS_INLINE_FUNCTION double Enge::hNImpl(const Config& config, double x, int n) {
        // Common linear Enge polynomial: retain the same arithmetic without
        // general powers for exponents zero and one. Higher derivatives vanish.
        if (config.a_m.size() == 2) {
            if (n == 0) return config.a_m(0) + (config.a_m(1) / config.lambda_m) * x;
            if (n == 1) return config.a_m(1) / config.lambda_m;
            return 0;
        }
        double hn = 0;
        // optimise by precalculating factor
        for (unsigned int i = n; i < config.a_m.size(); i++)
            hn += config.a_m(i) / Kokkos::pow(config.lambda_m, i) * Kokkos::pow(x, i - n)
                  * gsl_sf_fact_kokkos(i) / gsl_sf_fact_kokkos(i - n);
        return hn;
    }

    // g     = 1+exp(h)
    // g^(n) = d^ng/dx^n
    template <class Config>
    KOKKOS_INLINE_FUNCTION double Enge::gNImpl(const Config& config, int n, EngeWorkspace& ws) {
        if (n == 0) return 1 + ws.exp_h0;  // special case
        double gn = 0;
        for (size_t i = 0; i < config.hIndices[n].extent(0); ++i) {
            double gnj = config.hIndices[n](i, 0) * ws.exp_h0;
            for (size_t j = 1; j < config.hIndices[n].extent(1); ++j)
                gnj *= Kokkos::pow(ws.hNVec[j], config.hIndices[n](i, j));
            gn += gnj;
        }
        return gn;
    }

    template <class C>
    KOKKOS_INLINE_FUNCTION void Enge::functionDevice(
            const EngeConfig& config, double x, int n, C values) {
        functionPoint(config, x, n, values);
    }
    KOKKOS_INLINE_FUNCTION void Enge::setupWorkspace(
            const EngeConfig& config, double x, int n, EngeWorkspace& ws) {
        setupWorkspaceImpl(config, x, n, ws);
    }
    KOKKOS_INLINE_FUNCTION double Enge::getEnge(
            const EngeConfig& config, double x, int n, EngeWorkspace& ws) {
        return getEngeImpl(config, x, n, ws);
    }
    KOKKOS_INLINE_FUNCTION double Enge::hN(const EngeConfig& config, double x, int n) {
        return hNImpl(config, x, n);
    }
    KOKKOS_INLINE_FUNCTION double Enge::gN(const EngeConfig& config, int n, EngeWorkspace& ws) {
        return gNImpl(config, n, ws);
    }

}  // namespace endfieldmodel
