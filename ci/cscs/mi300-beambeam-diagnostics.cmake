cmake_minimum_required(VERSION 3.20)

# Test-only dashboard. A failed/crashed baseline must not prevent the IPC-off run.
# Use the existing MPI2 registration and binary; only filter the gtest case.
foreach(required BUILD_DIR BUILD_TYPE CDASH_LABEL CTEST_SITE)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "${required} must be defined")
  endif()
endforeach()
set(CTEST_SOURCE_DIRECTORY "$ENV{CI_PROJECT_DIR}")
set(CTEST_BINARY_DIRECTORY "${BUILD_DIR}")
set(CTEST_BUILD_CONFIGURATION "${BUILD_TYPE}")
# Preserve the phase markers even when the diagnostic passes.
set(CTEST_CUSTOM_MAXIMUM_PASSED_TEST_OUTPUT_SIZE 1048576)
set(CTEST_CUSTOM_MAXIMUM_FAILED_TEST_OUTPUT_SIZE 1048576)
set(test_regex "^TestBeamBeamFieldServicesMPI2$")
option(OPALX_DIAGNOSTIC_SUBMIT "Submit MI300 diagnostic results to CDash" ON)

# Fail rather than reporting a false green when a registration is missing.
execute_process(
  COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${BUILD_DIR}" -N -R "${test_regex}"
  RESULT_VARIABLE inventory_result OUTPUT_VARIABLE inventory ERROR_VARIABLE inventory_error)
if(NOT inventory_result EQUAL 0 OR NOT inventory MATCHES "Total Tests: 1([^0-9]|$)")
  message(FATAL_ERROR "Expected exactly one MPI2 registration: ${inventory}${inventory_error}")
endif()

set(ENV{GTEST_FILTER} "BeamBeamFieldServicesTest.GaussianFieldsAndPassiveWitnessGather")
set(ENV{OPALX_BEAMBEAM_DIAGNOSTICS} "1")
set(ENV{OMP_NUM_THREADS} "1")
set(ENV{OMP_PROC_BIND} "false")
set(evidence "${BUILD_DIR}/mi300-diagnostics")
file(MAKE_DIRECTORY "${evidence}")
set(any_failed FALSE)
foreach(variant IN ITEMS inherited-ipc ipc-disabled)
  if(variant STREQUAL "ipc-disabled")
    set(ENV{MPICH_GPU_IPC_ENABLED} "0")
  endif()
  # First run preserves the CI environment; second changes only GPU IPC.
  set(CTEST_BUILD_NAME "${CDASH_LABEL}-mi300-${BUILD_TYPE}-GaussianMPI2-${variant}")
  ctest_start(Experimental GROUP "Experimental")
  ctest_test(INCLUDE "${test_regex}" PARALLEL_LEVEL 1
    RETURN_VALUE test_result CAPTURE_CMAKE_ERROR test_error)
  file(STRINGS "${BUILD_DIR}/Testing/TAG" tag LIMIT_COUNT 1)
  set(test_xml "${BUILD_DIR}/Testing/${tag}/Test.xml")
  if(EXISTS "${test_xml}")
    configure_file("${test_xml}" "${evidence}/${variant}.xml" COPYONLY)
  else()
    set(any_failed TRUE)
  endif()
  set(test_log "${BUILD_DIR}/Testing/Temporary/LastTest_${tag}.log")
  if(EXISTS "${test_log}")
    configure_file("${test_log}" "${evidence}/${variant}.log" COPYONLY)
  endif()
  if(OPALX_DIAGNOSTIC_SUBMIT)
    ctest_submit(PARTS Test RETURN_VALUE submit_result CAPTURE_CMAKE_ERROR submit_error)
    if(NOT submit_result EQUAL 0 OR NOT submit_error EQUAL 0)
      set(any_failed TRUE)
    endif()
  endif()
  message(STATUS "Gaussian MPI2 ${variant}: test_result=${test_result}, test_error=${test_error}")
  if(NOT test_result EQUAL 0 OR NOT test_error EQUAL 0)
    set(any_failed TRUE)
  endif()
endforeach()
if(any_failed)
  message(FATAL_ERROR "MI300 diagnostics failed; both variants were attempted. See ${evidence}")
endif()
