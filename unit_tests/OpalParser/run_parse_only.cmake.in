# The build's Python may live inside a CSCS uenv that is absent on the test
# host. This test uses only the standard library, so a host Python is enough.
set(_python "@Python3_EXECUTABLE@")
if(NOT EXISTS "${_python}")
  unset(_python)
  find_program(_python NAMES python3 REQUIRED)
endif()

set(_launcher "@_parse_only_launcher@")
execute_process(
  COMMAND "${_python}" "${CMAKE_CURRENT_LIST_DIR}/test_parse_only.py"
          "${OPALX_EXECUTABLE}" --launcher ${_launcher}
  RESULT_VARIABLE _result)
if(NOT "${_result}" STREQUAL "0")
  message(FATAL_ERROR "ParseOnlyCLI failed: ${_result}")
endif()
