OPTION, PSDUMPFREQ     = 1000000;
OPTION, STATDUMPFREQ   = 1;
OPTION, STEPINFOFQ     = 1000000;
OPTION, CHECKPOINTFREQ = 32;
OPTION, VERSION        = 10900;

REAL NPART = 64;
REAL P0 = 0.005;

D1: DRIFT, L = 0.040, ELEMEDGE = 0.0;
M1: MONITOR, TYPE = TEMPORAL, OUTFN = "M1", ELEMEDGE = 0.012;
M2: MONITOR, TYPE = TEMPORAL, OUTFN = "M2", ELEMEDGE = 0.030;
TESTLINE: LINE = (D1, M1, M2);

DIST1: DISTRIBUTION, TYPE = GAUSS,
       SIGMAX = 1e-6, SIGMAY = 1e-6, SIGMAZ = 1e-6,
       SIGMAPX = 1e-7, SIGMAPY = 1e-7, SIGMAPZ = 1e-7,
       NPARTDIST = NPART;
ES1: EMISSIONSOURCE, DISTRIBUTION = DIST1;
SOURCES1: EMISSIONSOURCELIST = (ES1);

BINS1: BINNING, MAXBINS = 1, ADAPTIVEBINNING = FALSE;
FS1: FIELDSOLVER, TYPE = NONE, BINS = BINS1,
     NX = 4, NY = 4, NZ = 4,
     PARFFTX = TRUE, PARFFTY = TRUE, PARFFTZ = TRUE,
     BCFFTX = OPEN, BCFFTY = OPEN, BCFFTZ = OPEN,
     BBOXINCR = 1, GREENSF = STANDARD;

BEAM1: BEAM, PARTICLE = ELECTRON, NALLOC = NPART,
       SOURCES = SOURCES1, BCHARGE = 1e-15, PC = P0, CHARGE = -1;

TRACK, LINE = TESTLINE, BEAM = BEAM1,
       MAXSTEPS = {30, 30}, DT = {1e-12, 2e-12}, ZSTOP = {0.009, 0.040};
RUN, METHOD = "PARALLEL", FIELDSOLVER = FS1;
ENDTRACK;
STOP;
