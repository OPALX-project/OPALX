# Command-level COF regressions, using CMake's JSON parser and process runner.
# Invoked by CTest without an outer MPI launcher: each case launches OPALX itself.
cmake_minimum_required(VERSION 3.24)
include("${COF_CONFIG}")
file(READ "${CMAKE_CURRENT_LIST_DIR}/cof-housekeeping.in" template)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(root "${COF_WORK_ROOT}/cof-${COF_RANKS}rank-${run_id}")
file(MAKE_DIRECTORY "${root}")

function(fail reason)
  if(EXISTS "${root}/overwrite/readonly")
    file(CHMOD "${root}/overwrite/readonly" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
  endif()
  message(FATAL_ERROR "${reason}\nCase files and console logs: ${root}")
endfunction()

function(equal actual expected label)
  if(NOT "${actual}" STREQUAL "${expected}")
    fail("${label}: expected '${expected}', got '${actual}'")
  endif()
endfunction()

function(present log token expected)
  string(FIND "${log}" "${token}" position)
  if((expected AND position EQUAL -1) OR (NOT expected AND NOT position EQUAL -1))
    fail("Unexpected visibility of '${token}'")
  endif()
endfunction()

function(json_equal document expected)
  string(JSON actual GET "${document}" ${ARGN})
  equal("${actual}" "${expected}" "JSON ${ARGN}")
endfunction()

function(json_length document expected)
  string(JSON actual LENGTH "${document}" ${ARGN})
  equal("${actual}" "${expected}" "JSON length ${ARGN}")
endfunction()

function(json_positive document)
  string(JSON actual GET "${document}" ${ARGN})
  if(NOT actual GREATER 0)
    fail("JSON ${ARGN} must be positive, got ${actual}")
  endif()
endfunction()

function(run_case name)
  cmake_parse_arguments(RUN "TRACK;ELECTRON;COUPLED;OMIT_OUTPUT;EMPTY_OUTPUT"
    "LEVEL;OUTPUT;TIME;STEPS;FAILURE;DIRECTORY" "" ${ARGN})
  foreach(pair IN ITEMS "LEVEL;3" "TIME;0" "STEPS;5000" "OUTPUT;orbit.json")
    list(GET pair 0 key)
    list(GET pair 1 default)
    if(NOT DEFINED RUN_${key})
      set(RUN_${key} "${default}")
    endif()
  endforeach()
  if(RUN_DIRECTORY)
    set(work "${RUN_DIRECTORY}")
  else()
    set(work "${root}/${name}")
  endif()
  file(MAKE_DIRECTORY "${work}")
  set(TIME "${RUN_TIME}")
  set(MAXSTEPS "${RUN_STEPS}")
  if(RUN_OMIT_OUTPUT)
    set(OUTPUT "")
  elseif(RUN_EMPTY_OUTPUT)
    set(OUTPUT ", OUTPUT=\"\"")
  else()
    set(OUTPUT ", OUTPUT=\"${RUN_OUTPUT}\"")
  endif()
  set(TRACK "")
  if(RUN_TRACK)
    set(TRACK [=[
FS0: FIELDSOLVER, TYPE=NONE, NX=8, NY=8, NZ=8;
TRACK, LINE=FFA_RING, BEAM=B1, INITIALORBIT=FFA_ORBIT,
       DT=1e-9, MAXSTEPS=20000;
    RUN, METHOD="PARALLEL", FIELDSOLVER=FS0, TURNS=1;
ENDTRACK;
]=])
  endif()
  string(CONFIGURE "${template}" input @ONLY)
  if(RUN_ELECTRON)
    # Preserve reference beta-gamma and bend radius for the second species.
    string(REPLACE "PARTICLE=PROTON" "PARTICLE=ELECTRON" input "${input}")
    string(REPLACE "PC=0.132508266436" "PC=0.132508266436*510998.95/938272088.16" input "${input}")
    string(REPLACE "B0=0.1" "B0=-0.1*510998.95/938272088.16" input "${input}")
    string(REPLACE "B1" "BEAM2" input "${input}")
    string(REPLACE "FFA_ORBIT" "ELECTRON_ORBIT" input "${input}")
  endif()
  if(RUN_COUPLED)
    string(REPLACE "MAXPATH=40" "MAXPATH=40, SECTION={0,0,0,0,0,0.2}" input "${input}")
  endif()
  file(WRITE "${work}/case.in" "${input}")
  execute_process(
    COMMAND "${CMAKE_COMMAND}" -E env OMP_NUM_THREADS=1 OMP_PROC_BIND=false
      "${COF_MPIEXEC}" "${COF_NUMPROC_FLAG}" "${COF_RANKS}" ${COF_MPI_PREFLAGS}
      "${COF_EXECUTABLE}" ${COF_MPI_POSTFLAGS} --info "${RUN_LEVEL}" case.in
    WORKING_DIRECTORY "${work}" TIMEOUT 90
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  set(log "${stdout}${stderr}")
  file(WRITE "${work}/console.log" "${log}")
  if(RUN_FAILURE)
    if("${result}" STREQUAL "0")
      fail("${name}: expected a failure")
    endif()
    present("${log}" "${RUN_FAILURE}" TRUE)
  else()
    equal("${result}" "0" "${name} exit status")
    set(details FALSE)
    set(optics FALSE)
    if(RUN_LEVEL GREATER_EQUAL 5)
      set(details TRUE)
    endif()
    if(RUN_LEVEL GREATER_EQUAL 4)
      set(optics TRUE)
    endif()
    foreach(token IN ITEMS "Nominal closure position_m=" "Integrator=" "iteration damping="
        "Coordinates (x,px,y,py):" "Phase samples=" "lambda[0]" "lambda[1]" "lambda[2]" "lambda[3]")
      present("${log}" "${token}" "${details}")
    endforeach()
    foreach(token IN ITEMS "COF matrix and tunes:" "One-turn-matrix (x, px, y, py):" "Full tunes")
      present("${log}" "${token}" "${optics}")
    endforeach()
    present("${log}" "Stability is a numerical matrix diagnostic" FALSE)
    present("${log}" "Matrix eigenanalysis alone:" FALSE)
    if(optics)
      string(REGEX MATCHALL "COF matrix and tunes:" headings "${log}")
      list(LENGTH headings count)
      equal("${count}" "1" "rank-zero report count")
      string(REGEX MATCH "COF matrix and tunes:[^\n]*Near-integer warning: no" heading "${log}")
      if(NOT heading)
        fail("Near-integer status missing from COF heading")
      endif()
      string(REGEX MATCHALL "Near-integer warning:" warnings "${log}")
      list(LENGTH warnings count)
      equal("${count}" "1" "near-integer status count")
      present("${log}" "Full tunes (uncoupled planar):\n" TRUE)
      foreach(axis IN ITEMS horizontal/radial vertical)
        if(axis STREQUAL "vertical")
          set(symbol nuy)
        else()
          set(symbol nur)
        endif()
        string(REGEX MATCH ">([ ]+${axis}[ ]+)${symbol}=[-+0-9.eE]+" row "${log}")
        if(NOT row)
          fail("Missing formatted full tune ${symbol}")
        endif()
        string(LENGTH "${CMAKE_MATCH_1}" ${symbol}_column)
      endforeach()
      equal("${nur_column}" "${nuy_column}" "full-tune column alignment")
      foreach(coordinate IN ITEMS x px y py)
        string(REGEX MATCH ">[ ]+${coordinate} \\[[^\n]*\\]" row "${log}")
        string(REGEX MATCHALL "[-+]?[0-9]+\\.[0-9]+e[-+][0-9]+" entries "${row}")
        list(LENGTH entries count)
        equal("${count}" "4" "scientific matrix row ${coordinate}")
      endforeach()
    endif()
    if(RUN_TRACK)
      foreach(token IN ITEMS "Creating new file for data:" "OrbitThreader work ("
          "* OT reference:" "* OT segmentation:" "* OT maps:" "* OT output:")
        present("${log}" "${token}" "${details}")
      endforeach()
      file(GLOB_RECURSE positions "${work}/*_ElementPositions.sdds")
      if(NOT positions)
        fail("Logging level suppressed element-position file output")
      endif()
    endif()
  endif()
  file(GLOB temporaries "${work}/*.tmp.*")
  if(temporaries)
    fail("${name}: temporary output was not removed")
  endif()
  set(LAST_WORK "${work}" PARENT_SCOPE)
endfunction()

function(validate_result work beam species_name full_tunes)
  file(READ "${work}/orbit.json" document)
  json_length("${document}" 4)
  json_equal("${document}" "opalx.closed_orbits" schema)
  json_equal("${document}" 1 schema_version)
  json_length("${document}" 1 species)
  json_length("${document}" 1 orbits)
  string(TOLOWER "${beam}" lower_beam)
  json_equal("${document}" "orbit_${lower_beam}" orbits 0 id)
  json_equal("${document}" "${beam}" orbits 0 beam_id)
  string(JSON species_id GET "${document}" species 0 id)
  json_equal("${document}" "${species_id}" orbits 0 reference species_id)
  json_equal("${document}" "${species_name}" species 0 name)
  json_positive("${document}" species 0 rest_energy_eV)
  if(species_name STREQUAL "ELECTRON")
    json_equal("${document}" -1 species 0 charge_e)
  else()
    json_equal("${document}" 1 species 0 charge_e)
  endif()
  json_positive("${document}" orbits 0 reference kinetic_energy_MeV)
  set(index 0)
  foreach(coordinate IN ITEMS x px y py)
    json_equal("${document}" "${coordinate}" orbits 0 section coordinate_order ${index})
    if(coordinate STREQUAL "x" OR coordinate STREQUAL "y")
      set(unit m)
    else()
      set(unit "p/(mc)")
    endif()
    json_equal("${document}" "${unit}" orbits 0 section coordinate_units ${index})
    math(EXPR index "${index} + 1")
  endforeach()
  json_length("${document}" 4 orbits 0 section coordinate_order)
  json_length("${document}" 4 orbits 0 section coordinate_units)
  json_length("${document}" 4 orbits 0 solution section_coordinates)
  json_length("${document}" 4 orbits 0 solution closure_residual)
  json_equal("${document}" laboratory orbits 0 solution launch frame)
  json_equal("${document}" converged orbits 0 solver status)
  json_equal("${document}" DOP853 orbits 0 solver integrator)
  json_positive("${document}" orbits 0 solver iterations)
  string(JSON iterations GET "${document}" orbits 0 solver iterations)
  string(JSON evaluations GET "${document}" orbits 0 solver map_evaluations)
  if(NOT evaluations GREATER iterations)
    fail("Expected more map evaluations than accepted iterations")
  endif()
  json_length("${document}" 4 orbits 0 solver settings finite_difference_steps)
  json_length("${document}" 4 orbits 0 optics one_turn_matrix)
  json_length("${document}" 4 orbits 0 optics eigenvalues)
  foreach(index RANGE 0 3)
    json_length("${document}" 4 orbits 0 optics one_turn_matrix ${index})
    json_length("${document}" 2 orbits 0 optics eigenvalues ${index})
    foreach(component IN ITEMS real imag)
      string(JSON type TYPE "${document}" orbits 0 optics eigenvalues ${index} ${component})
      equal("${type}" NUMBER "eigenvalue component")
    endforeach()
  endforeach()
  json_equal("${document}" STABLE orbits 0 optics stability)
  if(full_tunes)
    json_equal("${document}" available orbits 0 optics full_tunes status)
    set(expected_type NUMBER)
  else()
    json_equal("${document}" unavailable orbits 0 optics full_tunes status)
    set(expected_type NULL)
  endif()
  foreach(key IN ITEMS horizontal_radial vertical phase_samples maximum_phase_step_rad)
    string(JSON type TYPE "${document}" orbits 0 optics full_tunes ${key})
    equal("${type}" "${expected_type}" "full-tune ${key}")
  endforeach()
  string(JSON diagnostic GET "${document}" orbits 0 optics full_tunes diagnostic)
  if(diagnostic STREQUAL "")
    fail("Missing full-tune diagnostic")
  endif()
  json_positive("${document}" orbits 0 diagnostics return_duration_s)
  json_positive("${document}" orbits 0 diagnostics path_length_m)
  string(JSON residual GET "${document}" orbits 0 diagnostics section_residual_m)
  if(residual LESS -1e-10 OR residual GREATER 1e-10)
    fail("Return section residual exceeds localization tolerance")
  endif()
endfunction()

run_case(overwrite)
set(work "${LAST_WORK}")
validate_result("${work}" B1 PROTON TRUE)
file(READ "${work}/orbit.json" first_json)
# A hard link holds the old inode: truncating in place would modify both names.
file(CREATE_LINK "${work}/orbit.json" "${work}/previous.json" RESULT link_result)
equal("${link_result}" 0 "create old-inode snapshot")
run_case(overwrite-again DIRECTORY "${work}" TIME 1e-9)
file(READ "${work}/previous.json" previous)
equal("${previous}" "${first_json}" "atomic replacement preserved old inode")
validate_result("${work}" B1 PROTON TRUE)
file(READ "${work}/orbit.json" saved)
json_equal("${first_json}" 0 orbits 0 solution launch time_s)
string(JSON time GET "${saved}" orbits 0 solution launch time_s)
# Allow the same few ulps from decimal input parsing as the old driver.
if(time LESS 9.99999999999999e-10 OR time GREATER 1.000000000000001e-9)
  fail("Replacement did not use the new launch timestamp")
endif()
run_case(failed-solve DIRECTORY "${work}" STEPS 1 FAILURE "No directed return within MAXSTEPS")
file(READ "${work}/orbit.json" after_failure)
equal("${after_failure}" "${saved}" "failed solve preserved result")
foreach(level IN ITEMS 4 5)
  run_case(level-${level} LEVEL ${level} TRACK)
  validate_result("${LAST_WORK}" B1 PROTON TRUE)
  file(READ "${LAST_WORK}/orbit.json" result)
  equal("${result}" "${first_json}" "logging level preserved JSON")
endforeach()
run_case(electron ELECTRON)
validate_result("${LAST_WORK}" BEAM2 ELECTRON TRUE)
file(READ "${LAST_WORK}/orbit.json" electron)
json_equal("${electron}" ELECTRON_ORBIT orbits 0 cof_id)
run_case(coupled COUPLED)
validate_result("${LAST_WORK}" B1 PROTON FALSE)
run_case(omitted OMIT_OUTPUT TRACK)
file(GLOB unexpected "${LAST_WORK}/*.json")
if(unexpected)
  fail("Omitted OUTPUT wrote a result file")
endif()
run_case(empty EMPTY_OUTPUT FAILURE "String value expected")
run_case(missing-parent OUTPUT "missing/orbit.json" FAILURE "Cannot create temporary COF OUTPUT")
if(UNIX)
  execute_process(COMMAND id -u OUTPUT_VARIABLE uid OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT uid STREQUAL "0")
    file(MAKE_DIRECTORY "${work}/readonly")
    file(WRITE "${work}/readonly/orbit.json" "${saved}")
    file(CHMOD "${work}/readonly" PERMISSIONS OWNER_READ OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    run_case(unwritable DIRECTORY "${work}" OUTPUT "readonly/orbit.json" FAILURE "Cannot create temporary COF OUTPUT")
    file(CHMOD "${work}/readonly" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
    file(READ "${work}/readonly/orbit.json" preserved)
    equal("${preserved}" "${saved}" "write failure preserved result")
    file(GLOB unexpected "${work}/readonly/*.tmp.*")
    if(unexpected)
      fail("Failed write left temporary output")
    endif()
  endif()
endif()
file(MAKE_DIRECTORY "${root}/blocked/orbit.json")
file(WRITE "${root}/blocked/orbit.json/keep" "previous contents")
run_case(rename-failure DIRECTORY "${root}/blocked" FAILURE "Cannot replace COF OUTPUT")
file(READ "${root}/blocked/orbit.json/keep" marker)
equal("${marker}" "previous contents" "failed rename preserved destination")
file(REMOVE_RECURSE "${root}")
message(STATUS "PASS: COF housekeeping on ${COF_RANKS} rank(s)")
