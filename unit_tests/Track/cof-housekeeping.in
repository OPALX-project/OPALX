// Symmetric, weak-focusing four-sector ring; no external field maps required.
OPTION, ECHO=FALSE, ENABLEHDF5=FALSE, ENABLELINEARTRANSFERMAPS=FALSE,
        PSDUMPFREQ=0, STATDUMPFREQ=100, REPARTFREQ=0, CHECKPOINTFREQ=0;
REAL RREF = 4.42;
REAL LCELL = PI*RREF/2;
M0: SCALINGFFAMAGNET, L=LCELL, R0=RREF, B0=0.1,
    FIELD_INDEX=-0.5, TAN_DELTA=0, MAX_Y_POWER=4, FRINGE_LENGTH=0.02,
    RADIAL_NEG_EXTENT=0.8, RADIAL_POS_EXTENT=1.2, HEIGHT=1,
    X=0, Y=0, Z=0, THETA=0, PHI=0, PSI=0;
M1: M0, X=-RREF, Z=RREF, THETA=-PI/2;
M2: M0, X=-2*RREF, Z=0, THETA=-PI;
M3: M0, X=-RREF, Z=-RREF, THETA=-3*PI/2;
FFA_RING: RING=(M0,M1,M2,M3);
D0: DISTRIBUTION, TYPE=GAUSS, NPARTDIST=8,
    SIGMAX=0, SIGMAY=0, SIGMAZ=0, SIGMAPX=0, SIGMAPY=0, SIGMAPZ=0;
S0: EMISSIONSOURCE, DISTRIBUTION=D0, T0=0;
SL0: EMISSIONSOURCELIST=(S0);
B1: BEAM, PARTICLE=PROTON, PC=0.132508266436,
    NALLOC=8, BCHARGE=1e-15, SOURCES=SL0;
FFA_ORBIT: COF, LINE=FFA_RING, BEAM=B1,
    DT=1e-9, TIMEINTEGRATOR="DOP853", T0=@TIME@,
    MAXSTEPS=@MAXSTEPS@, MAXPATH=40,
    X=0.001, PX=1e-5, Y=0.001, PY=1e-5,
    FDSTEP={1e-5,1e-6,1e-5,1e-6}, XTOL=1e-10, PTOL=1e-10@OUTPUT@;
@TRACK@
STOP;
