OPTION, PSDUMPFREQ = 0;
OPTION, STATDUMPFREQ = 1;
OPTION, BOUNDPDESTROY = 10;
OPTION, AUTOPHASE = 4;
OPTION, VERSION = 10900;
OPTION, SEED = 42;

TITLE, STRING = "Single-rank FFT2D5 end-to-end regression";

REAL N = 8;
REAL NPART = 512;
REAL EDES = 1.0e-6;
REAL GAMMA = (EDES + EMASS) / EMASS;
REAL BETA = SQRT(1.0 - 1.0 / (GAMMA * GAMMA));
REAL P0 = GAMMA * BETA * EMASS;

D1: DRIFT, L = 0.01, ELEMEDGE = 0.0;
LINE1: LINE = (D1);

FS1: FIELDSOLVER, TYPE = "FFT2D5",
    NX = N, NY = N, NZ = N,
    PARFFTX = FALSE, PARFFTY = FALSE, PARFFTZ = FALSE,
    PIPEMODE = "NONE",
    PIPESIZEX = 0.02, PIPESIZEY = 0.02,
    BEAMR = 1.0e-3,
    CLOSEDRING = FALSE,
    SCATTERLONGITUDINALLY = TRUE;

DIST1: DISTRIBUTION, TYPE = GAUSS,
    SIGMAX = 1.0e-4, SIGMAY = 1.0e-4, SIGMAZ = 1.0e-4,
    SIGMAPX = 1.0e-6, SIGMAPY = 1.0e-6, SIGMAPZ = 1.0e-6,
    NPARTDIST = NPART;
SOURCE1: EMISSIONSOURCE, DISTRIBUTION = DIST1;
SOURCES: EMISSIONSOURCELIST = (SOURCE1);

BEAM1: BEAM, PARTICLE = ELECTRON, NALLOC = NPART,
    BCHARGE = 1.0e-12, SOURCES = SOURCES, CHARGE = -1, PC = P0;

TRACK, LINE = LINE1, BEAM = BEAM1, MAXSTEPS = 2,
    DT = 1.0e-12, ZSTOP = 0.01;
RUN, METHOD = "PARALLEL", FIELDSOLVER = FS1;
ENDTRACK;
QUIT;
